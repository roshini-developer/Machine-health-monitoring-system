    {
        "id": "369ff19898b911a9",
        "type": "function",
        "z": "0fc4d4494b8760e4",
        "name": "MHMS connection status ",
        "func": "const s = (msg.status?.text || \"\").toLowerCase();\n\nif (s.includes(\"connecting\")) {\n    msg.payload = \"MQTT Connecting...\";\n} else if (s.includes(\"disconnected\")) {\n    msg.payload = \"MQTT Disconnected\";\n} else if (s.includes(\"connected\")) {\n    msg.payload = \"MQTT Connected\";\n} else {\n    msg.payload = \"MQTT Status Unknown\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
